\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Daily log-returns ($y_t$) of the NZD/USD exchange rate. The series demonstrates clear volatility clustering, characterized by alternating periods of high market turbulence and relative stability.}}{1}{figure.1}\protected@file@percent }
\newlabel{fig:returns}{{1}{1}{Daily log-returns ($y_t$) of the NZD/USD exchange rate. The series demonstrates clear volatility clustering, characterized by alternating periods of high market turbulence and relative stability}{figure.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Discussion}{1}{section.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Particle filter estimate of the latent log-volatility state ($h_t$). The dynamic Bayesian update step enables the filter to continuously track unobserved structural shifts in market variance.}}{2}{figure.2}\protected@file@percent }
\newlabel{fig:volatility}{{2}{2}{Particle filter estimate of the latent log-volatility state ($h_t$). The dynamic Bayesian update step enables the filter to continuously track unobserved structural shifts in market variance}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Effective Sample Size ($N_{eff}$) diagnostic tracking particle degeneracy. The horizontal dashed red line indicates the algorithmic safety net at $M/2 = 500$. The recurrent sawtooth pattern confirms that Sequential Importance Resampling effectively eliminated weak hypotheses and cloned highly weighted particles.}}{2}{figure.3}\protected@file@percent }
\newlabel{fig:neff}{{3}{2}{Effective Sample Size ($N_{eff}$) diagnostic tracking particle degeneracy. The horizontal dashed red line indicates the algorithmic safety net at $M/2 = 500$. The recurrent sawtooth pattern confirms that Sequential Importance Resampling effectively eliminated weak hypotheses and cloned highly weighted particles}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Comparison of estimated variance ($\sigma _t^2$) between the stochastic volatility particle filter and a naive 30-day rolling window. The Bayesian likelihood weighting reacts instantly to market shocks, whereas the rolling window demonstrates a rigid structural lag.}}{3}{figure.4}\protected@file@percent }
\newlabel{fig:comparison}{{4}{3}{Comparison of estimated variance ($\sigma _t^2$) between the stochastic volatility particle filter and a naive 30-day rolling window. The Bayesian likelihood weighting reacts instantly to market shocks, whereas the rolling window demonstrates a rigid structural lag}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Autocorrelation function (ACF) of the squared standardized residuals ($u_t^2$). Calibrated with parameters $\phi = 0.93$ and $\sigma _\eta = 0.2$, the lack of significant lags extending beyond the 95\% confidence intervals (dashed blue lines) confirms the hidden state successfully absorbed the underlying volatility clustering.}}{3}{figure.5}\protected@file@percent }
\newlabel{fig:acf}{{5}{3}{Autocorrelation function (ACF) of the squared standardized residuals ($u_t^2$). Calibrated with parameters $\phi = 0.93$ and $\sigma _\eta = 0.2$, the lack of significant lags extending beyond the 95\% confidence intervals (dashed blue lines) confirms the hidden state successfully absorbed the underlying volatility clustering}{figure.5}{}}
